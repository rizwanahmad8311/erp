# Copy to .env and fill in. .env is git-ignored and never committed.
#
#   dev:  cp .env.example .env   (leave the defaults, they work)
#   prod: create .env on the Windows PC next to manage.py

# Which settings module to load.
#   config.settings.dev   macOS + Docker
#   config.settings.prod  Windows office PC
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-before-production

DEBUG=True

# Comma-separated. In production list the LAN IP and hostname of the PC:
#   ALLOWED_HOSTS=192.168.1.50,erp-pc,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Only needed if the office LAN is fronted by TLS. Comma-separated, scheme required.
#   CSRF_TRUSTED_ORIGINS=https://erp-pc
CSRF_TRUSTED_ORIGINS=

# Set True only when a real certificate is in front of waitress. Turning this
# on without one will lock every user out of the LAN site.
USE_TLS=False

TIME_ZONE=Asia/Karachi
LANGUAGE_CODE=en-us

# Allow stock to go negative. Leave False unless this office genuinely invoices
# before the goods receipt is entered — a negative balance has no cost behind
# it, so everything issued while it is under water is valued approximately.
ALLOW_NEGATIVE_STOCK=False

# waitress (production only)
ERP_HOST=0.0.0.0
ERP_PORT=8000
ERP_THREADS=8
